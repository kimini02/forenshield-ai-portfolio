# Backend API origin used by Next.js rewrites in deployed/local backend mode.
BACKEND_API_ORIGIN=http://localhost:8080

# Public API base URL used by browser-side API clients.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Production/deploy mode should call the backend instead of mock data.
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_UPLOAD_ONLY_MODE=false

# true: 새로고침·URL 직접 접속 시 refresh 쿠키를 이용해 세션을 복구합니다.
# 명시적으로 false일 때만 자동 세션 복구를 차단합니다.
NEXT_PUBLIC_AUTH_REFRESH_ENABLED=true
# 로그인 시점부터 유지할 프론트 세션 최대 시간(분). 새로고침으로 연장되지 않습니다.
NEXT_PUBLIC_AUTH_SESSION_TIMEOUT_MINUTES=15
